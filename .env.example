ENV_FILE_OVERRIDE=0

# Target to follow. Accepts a profile URL, username, or wallet address.
TARGET_PROFILE=https://pump.fun/profile/manawinss

# Created account profile source.
# USE_PROFILE_DATA=1 uses entries from PROFILE_DATA_PATH.
# USE_PROFILE_DATA=0 uses PUMP_USERNAME/PUMP_BIO/PFP_PATH below.
USE_PROFILE_DATA=0
PROFILE_DATA_PATH=data.json

PUMP_USERNAME=katakama
PUMP_BIO=the sexiest king
PFP_PATH=pfp.jpg
SKIP_PROFILE_IMAGE=0
AUTO_UNIQUE_USERNAME=1

# Output.
WALLET_OUTPUT_PATH=generated_pump_profile_wallet.json

# Proxies.
# PROXY_MODE can be "file" or "off".
PROXY_MODE=file
PROXY_FILE=proxies.txt
TEST_PROXY_BEFORE_USE=1
PROXY_TEST_URL=https://api.ipify.org?format=json
PROXY_TEST_TIMEOUT=10
MAX_PROXY_ATTEMPTS=10
