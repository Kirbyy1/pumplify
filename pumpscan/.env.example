# Copy to pumpscan/.env and fill in. Each key unlocks one more KOL list for
# `python sync_kols.py`; sources without a key are skipped.

# https://madeonsol.com/pricing  (free tier: 200 calls/day, ~1,000 KOLs)
MADEONSOL_API_KEY=

# https://www.solanatracker.io  (free tier: 2,500 requests/month)
SOLANATRACKER_API_KEY=

# Optional: where the Fomo snapshot lives
# PUMPSCAN_FOMO_DB=C:\Users\alekkum\PycharmProjects\backrun\fomo_wallets.db
